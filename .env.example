# driftlens reads no secrets. These environment variables are optional.

# Cluster to compare against (same rules as kubectl). --kubeconfig overrides.
KUBECONFIG=

# Directory holding kube-apiserver and etcd for envtest-backed tests and the
# demo. `make envtest` fills setup-envtest's default cache; set this only to
# point at another copy.
KUBEBUILDER_ASSETS=

# Disable ANSI colors in text output (https://no-color.org).
NO_COLOR=

# When set, envtest-backed tests fail instead of skipping if the API server
# binaries are missing. `make check` always sets it.
DRIFTLENS_REQUIRE_ENVTEST=
